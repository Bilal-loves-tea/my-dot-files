{
    "$schema": "/etc/xdg/swaync/configSchema.json",

    "positionX": "right",
    "positionY": "top",
    "layer": "overlay",
    "control-center-layer": "top",
    "layer-shell": true,
    "cssPriority": "user",

    "control-center-margin-top": 8,
    "control-center-margin-right": 8,
    "control-center-width": 380,
    "control-center-height": 650,

    "notification-window-width": 380,
    "notification-icon-size": 44,

    "timeout": 6,
    "timeout-low": 4,
    "timeout-critical": 0,

    "fit-to-screen": true,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,

    "widgets": [
        "mpris",
        "title",
        "dnd",
        "notifications"
    ],

    "widget-config": {
        "title": {
            "text": "Notifications",
            "clear-all-button": true,
            "button-text": "Clear all"
        },
        "dnd": {
            "text": "Do Not Disturb"
        },
        "mpris": {
            "image-size": 64,
            "image-radius": 10
        }
    }
}
